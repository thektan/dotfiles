#!/usr/bin/env bash

############################################################
# Environment Variables                                    #
############################################################

# Defining hostname for liferay properties file
export HOSTNAME=$(hostname)

# Setting ANT_OPS variable for ant command
export ANT_OPTS="-Xms8g -Xmx8g"

# Allocate more memory to prevent getting stuck on
# `[echo] Executing Gradle task: deploy` while running `ant all`.
export GRADLE_OPTS="-Xmx8g"

############################################################
# Java                                                     #
############################################################

# export JAVA_HOME_8=$(/usr/libexec/java_home -v1.8)
# export JAVA_HOME_7=$(/usr/libexec/java_home -v1.7)
# export JAVA_HOME_14=$(/usr/libexec/java_home -v14)

# Default java
# export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-11.jdk/Contents/Home
# export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-21.jdk/Contents/Home
# export JAVA_HOME=$JAVA_HOME_8

############################################################
# Functions
############################################################

# Find gradle in the root of git directory and execute it.
# Otherwise use globally installed gradle.
# @author Nate Cavanaugh
gradle() {
	local root_level=$(git rev-parse --show-toplevel 2>/dev/null)

	if [[ -n "$root_level" && -f "$root_level/gradlew" ]];
		then root_level="$root_level/gradlew"
	else
		root_level=$(which gradle)
fi

	"$root_level" $@
}

# Get the last mentioned JIRA ticket id from the commit log
# @author Nate Cavanaugh
latest_jira_ticket() {
	git log $1 --oneline | grep -Eo '([A-Z]{2,}-)([0-9]+)' -m 1;
}

# Open the url to the latest JIRA ticket referenced in the log
open_jira_ticket() {
	if [ -z "$1" ]; then
		latestTicket=$(latest_jira_ticket);

		echo "Opening https://liferay.atlassian.net/browse/$latestTicket"
		open https://liferay.atlassian.net/browse/$latestTicket;
	fi

	if [ -n "$1" ]; then
		echo "Opening https://liferay.atlassian.net/browse/$1"
		open https://liferay.atlassian.net/browse/$1;
	fi
}

# Gets the JIRA url for the latest JIRA ticket referenced in the log
latest_jira_ticket_url() {
	export latestTicketURL="https://liferay.atlassian.net/browse/$(latest_jira_ticket)";
}

# Submit a pull request
# $1 user - pull request recipient
# $2 repo - Github repository to submit pull request to
# $3 branch - branch to submit pull request to
#
# Depedencies:
# brew install gh (https://cli.github.com/) Github CLI
# brew install jq (https://formulae.brew.sh/formula/jq) JSON processor
# latest_jira_ticket()
# open_jira_ticket()
ghpr() {
	default_user="thektan";
	default_repo="liferay-portal";
	default_branch="master";

	if [ "$1" = "help" ]; then
		echo "Submits a Github pull request pulling information from the latest commit's Jira ticket.";
		echo "";
		echo "USAGE";
		echo "  ghpr <user> <repo> <branch>";
		echo "";
		echo "DEFAULTS";
		echo "  user: $default_user";
		echo "  repo: $default_repo";
		echo "  branch: $default_branch";
	else
		# Gather information
		user=$1;
		repo=$2;
		branch=$3;
		ticket=$(latest_jira_ticket);
		title="$ticket $(curl -s "https://liferay.atlassian.net/rest/api/2/issue/$ticket" | jq -r ".fields.summary")";

		# Set default user
		if [ -z "$user" ] || [ "$user" = "null" ]; then
			user=$default_user;
		fi;

		# Set default repo
		if [ -z "$repo" ] || [ "$repo" = "null" ]; then
			repo=$default_repo;
		fi;

		# Set default branch
		if [ -z "$branch" ] || [ "$branch" = "null" ]; then
			branch=$default_branch;
		fi;

		echo "Submitting pull request to $repo $user:$branch";

		# -z = string is null and has zero length
		# @see https://tldp.org/LDP/abs/html/comparison-ops.html
		if [ -z "$title" ] || [ "$title" = "null" ]; then
			title=""
		fi;

		# Open Jira ticket to manually workflow
		open_jira_ticket;

		# Open pull request
		gh pr create -R $user/$repo -B $branch -t $title -b "https://liferay.atlassian.net/browse/$ticket" -w;
	fi
}

# Checks if the local tomcat version is in sync with the upstream version.
# If not, it updates the local properties file.
checkTomcatVersion() {
	local user_properties_file="app.server.${USER}.properties"
	local upstream_properties_file="app.server.properties"

	if [[ ! -f "$user_properties_file" ]]; then
		printf "⚠️  \033[33mWARNING: User properties file not found: %s\033[0m\n" "$user_properties_file"
		return 1
	fi

	if [[ ! -f "$upstream_properties_file" ]]; then
		printf "⚠️  \033[33mWARNING: Upstream properties file not found: %s\033[0m\n" "$upstream_properties_file"
		return 1
	fi

	local localTomcatVersion
	local upstreamTomcatVersion

	localTomcatVersion=$(grep "^[[:space:]]*app.server.tomcat.version=" "$user_properties_file" | cut -d'=' -f2 | xargs)
	upstreamTomcatVersion=$(grep "^[[:space:]]*app.server.tomcat.version=" "$upstream_properties_file" | cut -d'=' -f2 | xargs)

	if [[ "$upstreamTomcatVersion" != "$localTomcatVersion" ]]; then
		printf "⚠️  \033[33mTomcat version is out of sync.\033[0m\n"
		printf "   - Your version:     %s\n" "${localTomcatVersion}"
		printf "   - Upstream version: %s\n" "${upstreamTomcatVersion}"
		printf "   Updating %s...\n" "${user_properties_file}"

		# Replace the current tomcat version with the upstream version.
		sed -i \
			-e "s/^\([[:space:]]*app.server.tomcat.version=\).*/\1${upstreamTomcatVersion}/" \
			-e "s/\(tomcat-\)[0-9\.]*/\1${upstreamTomcatVersion}/" \
			"$user_properties_file"

		printf "✅ Tomcat version updated to %s in %s\n" "${upstreamTomcatVersion}" "${user_properties_file}"
	else
		printf "✅ Tomcat version is up to date. Current version: %s\n" "$localTomcatVersion"
	fi

	return 0
}

# Copies vscode settings.json files into portal modules to add peacock coloring.
setupPortalVSCode() {
	# clay
	local clayDir=~/Developer/clay

	mkdir "$clayDir/.vscode";
	cp "$DOTFILES/vscode/clay/settings.json" "$clayDir/.vscode";
	echo "clay";

	# frontend-data-set-web
	local frontendDataSetWebDir=modules/apps/frontend-data-set/frontend-data-set-web

	mkdir "$frontendDataSetWebDir/.vscode";
	cp "$DOTFILES/vscode/frontend-data-set-web/settings.json" "$frontendDataSetWebDir/.vscode";
	echo "frontend-data-set-web";

	# portal-language-lang
	local portalLanguageLangDir=modules/apps/portal-language/portal-language-lang

	mkdir "$portalLanguageLangDir/.vscode";
	cp "$DOTFILES/vscode/portal-language-lang/settings.json" "$portalLanguageLangDir/.vscode";
	echo "portal-language-lang";

	# portal-search-web
	local portalSearchWebDir=modules/apps/portal-search/portal-search-web

	mkdir "$portalSearchWebDir/.vscode";
	cp "$DOTFILES/vscode/portal-search-web/settings.json" "$portalSearchWebDir/.vscode";
	echo "portal-search-web";

	# search-experiences-web
	local searchExperiencesWebDir=modules/dxp/apps/search-experiences/search-experiences-web

	mkdir "$searchExperiencesWebDir/.vscode";
	cp "$DOTFILES/vscode/search-experiences-web/settings.json" "$searchExperiencesWebDir/.vscode";
	echo "search-experiences-web";

	# playwright
	local playwrightDir=modules/test/playwright

	mkdir "$playwrightDir/.vscode";
	cp "$DOTFILES/vscode/playwright/settings.json" "$playwrightDir/.vscode";
	echo "playwright";
}

# Updates libraries and builds portal.
# --setup: To include setup commands
buildPortal() {
	if [[ $* == *--setup* ]]; then
		echo "ℹ️ Building portal WITH setup commands (ant setup-profile-dxp and ant setup-sdk)";
	else
		echo "ℹ️ Building portal WITHOUT setup commands (ant setup-profile-dxp and ant setup-sdk)";
		echo "Use 'buildPortal --setup' to run with setup commands.";
	fi

	starttime=$(date +%s.%N);

	echo "";
	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ 🤖 Checking tomcat version                                        ║";
	echo "╚═══════════════════════════════════════════════════════════════════╝";

	checkTomcatVersion;

	# Stop the function if tomcat version isn't up to date.
	# This checks if function returns 1, a non-zero, which indicates an error.
	if [ $? -eq 1 ]; then
		return;
	fi

	if [[ $* == *--setup* ]]; then
		echo "";
		echo "╔═══════════════════════════════════════════════════════════════════╗";
		echo "║ 🤖 Running 'ant setup-profile-dxp'                                ║";
		echo "╚═══════════════════════════════════════════════════════════════════╝";

		ant setup-profile-dxp;

		echo "";
		echo "╔═══════════════════════════════════════════════════════════════════╗";
		echo "║ 🤖 Running 'ant setup-sdk'                                        ║";
		echo "╚═══════════════════════════════════════════════════════════════════╝";

		ant setup-sdk;
	fi

	echo "";
	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ 🤖 Running 'ant all'                                              ║";
	echo "╚═══════════════════════════════════════════════════════════════════╝";

	ant all;

	echo "";
	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ 🤖 Setting up VS Code color settings                              ║";
	echo "╚═══════════════════════════════════════════════════════════════════╝";

	setupPortalVSCode;

	echo "";
	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ 🤖 Setting up IntelliJ                                            ║";
	echo "╚═══════════════════════════════════════════════════════════════════╝";

	/Users/ktan/Developer/liferay-intellij/intellij "$@";

	cd -;

	endtime=$(date +%s.%N);

	duration=$(echo "scale=9; ($endtime - $starttime) / 60" | bc);

	echo "";
	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ ⏲️ buildPortal complete                                           ║";
	echo "╚═══════════════════════════════════════════════════════════════════╝";
	echo "\e[32m   ⏱️ Total time: $duration minutes\e[0m";
}

# Gets a formatted branch name for a Jira ticket.
#
# Example:
# jl LPS-155716
# **[LPS-155716](https://liferay.atlassian.net/browse/LPS-155716) SXPElement field localization breaks with nested fields**
getBranchName() {
	if [ -z "$1" ] || [ "$1" = "help" ]; then
		echo "Gets a formatted branch name for a Jira ticket.";
		echo "";
		echo "USAGE";
		echo "  getBranchName LPS-######";
		echo "";
		echo "OUTPUT";
		echo "  LPS-#####_LPS-#####_TitleCamelCased";
	else
		# Gather information
		ticket=$1;

		title="$(curl -s "https://liferay.atlassian.net/rest/api/2/issue/$ticket" | jq -r ".fields.summary")";
		parentTicket="$(curl -s "https://liferay.atlassian.net/rest/api/2/issue/$ticket" | jq -r ".fields.parent.key")";

		# -z = string is null and has zero length
		# @see https://tldp.org/LDP/abs/html/comparison-ops.html
		if [ -z "$title" ] || [ "$title" = "null" ]; then
			title=""
		fi;

		# @see https://stackoverflow.com/a/34420162/5092054
		titleCamelCased=$(sed -r 's/Technical Task \| //I; s/[^a-zA-Z0-9 ]//g; s/(^| )(\w)/\U\2/g' <<< "$title");

		# Build output
		output="$parentTicket"_"$ticket"_"$titleCamelCased";

		# Copy output to clipboard
		echo $output | pbcopy;

		# Success message
		echo "📋 Copied to clipboard:";
		echo "$output";
	fi
}

# Gets a labeled Jira link with ticket number and title for easy pasting on
# slack messages or notes.
#
# Example:
# jl LPS-155716
# **[LPS-155716](https://liferay.atlassian.net/browse/LPS-155716) SXPElement field localization breaks with nested fields**
jl() {
	if [ -z "$1" ] || [ "$1" = "help" ]; then
		echo "Creates a markdown for a jira ticket";
		echo "";
		echo "USAGE";
		echo "  jl LPS-######";
		echo "";
		echo "OUTPUT";
		echo "  [LPS-#####](https://liferay.atlassian.net/browse/LPS-#####) Ticket title";
	else
		# Gather information
		ticket=$1;
		title="$(curl -s "https://liferay.atlassian.net/rest/api/2/issue/$ticket" | jq -r ".fields.summary")";
		type="$(curl -s "https://liferay.atlassian.net/rest/api/2/issue/$ticket" | jq -r ".fields.issuetype.name")";

		# -z = string is null and has zero length
		# @see https://tldp.org/LDP/abs/html/comparison-ops.html
		if [ -z "$title" ] || [ "$title" = "null" ]; then
			title=""
		fi;

		# Get ticket type emoji
		if [ "$type" = "Story" ]; then
			typeEmoji="📗"
		fi;

		# Get ticket type emoji
		if [ "$type" = "Bug" ] || [ "$type" = "Regression Bug" ]; then
			typeEmoji="🐞"
		fi;

		# Build message
		# message="**$typeEmoji [$ticket](https://liferay.atlassian.net/browse/$ticket) ($title)**"
		# message="$ticket ($title) https://liferay.atlassian.net/browse/$ticket"
		message="[$ticket](https://liferay.atlassian.net/browse/$ticket) $title"

		# Copy message to clipboard
		echo $message | pbcopy;

		# Success message
		echo "📋 Copied to clipboard:";
		echo "$message";
	fi
}

# Gracefully kill the given pids: SIGTERM first (fires Tomcat's JVM shutdown
# hook for a clean OSGi/Lucene/DB flush), escalate to SIGKILL only if needed.
_kt_kill() {
	local pids="$1"
	echo "  → SIGTERM $pids (graceful shutdown)"
	kill ${=pids} 2>/dev/null

	# Give the shutdown hook time to run
	local i
	for i in {1..15}; do
		kill -0 ${=pids} 2>/dev/null || { echo "  ✅ Shut down cleanly."; return 0; }
		sleep 1
	done

	echo "  ⚠️  Still alive after 15s, escalating to SIGKILL (kill -9)"
	kill -9 ${=pids} 2>/dev/null
	echo "  🟥 Force killed."
}

# Kill tomcat server
kt() {
	# kt branchName -> kill by bundle path (backwards compatible)
	if [ -n "$1" ] && ! [[ "$1" =~ ^[0-9]+$ ]]; then
		local pids
		pids=$(pgrep -f "$1/bundles/tomcat")
		if [ -z "$pids" ]; then
			echo "No running tomcat process for bundle at $1/bundles/tomcat"
			return 1
		fi
		echo "🟥 Killing process for bundle at $1/bundles/tomcat\n"
		_kt_kill "$pids"
		return $?
	fi

	# Discover running tomcat bundles by their catalina.base path
	local lines
	lines=$(ps -axww -o pid=,command= | grep 'catalina.base=' | grep -v grep)

	if [ -z "$lines" ]; then
		echo "No running tomcat bundles found."
		return 0
	fi

	typeset -A bundlePids
	local order=()

	while IFS= read -r line; do
		[ -z "$line" ] && continue
		local pid="${line%% *}"
		local base="${line##*-Dcatalina.base=}"
		base="${base%% *}"
		if [[ -z "${bundlePids[$base]}" ]]; then
			order+=("$base")
			bundlePids[$base]="$pid"
		else
			bundlePids[$base]="${bundlePids[$base]} $pid"
		fi
	done <<< "$lines"

	# kt <number> -> kill the listed bundle
	if [ -n "$1" ]; then
		local base="${order[$1]}"
		if [ -z "$base" ]; then
			echo "❌ No tomcat bundle [$1]. Run kt to list running bundles."
			return 1
		fi
		echo "🟥 Killing tomcat bundle [$1] at $base (pids: ${bundlePids[$base]})\n"
		_kt_kill "${bundlePids[$base]}"
		return $?
	fi

	# kt -> list running bundles
	echo "Running tomcat bundles:"
	local i=1
	for base in "${order[@]}"; do
		echo "  [$i] $base (pids: ${bundlePids[$base]})"
		i=$((i + 1))
	done
	echo ""
	echo "Usage: kt <number>      kill the listed bundle"
	echo "       kt <branchName>  kill by bundle path"
}

# Start tomcat server
st() {
	local dirName="$1";

	# No argument: present a numbered list of bundles to choose from.
	if [ -z "$dirName" ]; then
		local bundles=();
		local d;
		for d in "$HOME"/Developer/*/bundles; do
			[ -d "$d" ] && bundles+=("$d");
		done;

		if [ ${#bundles[@]} -eq 0 ]; then
			echo "❌ No ~/Developer/*/bundles directories found.";
			return 1;
		fi

		echo "╔═══════════════════════════════════════════════════════════════════╗";
		echo "║ 📦 Select a bundle to start                                       ║";
		echo "╚═══════════════════════════════════════════════════════════════════╝";
		local i=1;
		for d in "${bundles[@]}"; do
			echo "  [$i] ${d#$HOME/Developer/}";
			i=$((i + 1));
		done

		local choice;
		printf "Enter a number: ";
		read choice;

		if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#bundles[@]} ]; then
			echo "❌ Invalid selection.";
			return 1;
		fi

		# zsh arrays are 1-indexed, bash arrays are 0-indexed.
		if [ -n "$ZSH_VERSION" ]; then
			dirName="${bundles[$choice]}";
		else
			dirName="${bundles[$((choice - 1))]}";
		fi
		dirName="${dirName%/bundles}";
		dirName="${dirName#$HOME/Developer/}";
	fi

	local baseDir="$HOME/Developer/$dirName/bundles";

	if [ ! -d "$baseDir" ]; then
		echo "❌ Bundle directory not found at $baseDir";
		return 1;
	fi

	local tomcatDir=$(find "$baseDir" -maxdepth 1 -type d -name "tomcat*" | head -n 1);

	if [ -z "$tomcatDir" ]; then
		echo "❌ No tomcat-* directory found in $baseDir";
		return 1;
	fi

	local tomcatPath="$tomcatDir/bin";

	if [ ! -d "$tomcatPath" ]; then
		echo "❌ Tomcat bin directory not found at $tomcatPath";
		return 1;
	fi

	# Ensure MySQL is running before starting tomcat.
	echo "";
	if ! pgrep -x mysqld >/dev/null 2>&1; then
		echo "╔═══════════════════════════════════════════════════════════════════╗";
		echo "║ 🐬 MySQL is not running — starting it...                          ║";
		echo "╚═══════════════════════════════════════════════════════════════════╝";
		sudo mysql.server start || { echo "❌ Failed to start MySQL."; return 1; }
	else
		echo "╔═══════════════════════════════════════════════════════════════════╗";
		echo "║ 🐬 MySQL is already running                                       ║";
		echo "╚═══════════════════════════════════════════════════════════════════╝";
	fi

	cd "$tomcatPath";

	echo "";
	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ 🐈 Starting Tomcat                                                ║";
	echo "╚═══════════════════════════════════════════════════════════════════╝";
	echo "   📂 $tomcatPath";
	echo "";

	./catalina.sh jpda run;
}

############################################################
# Gradle
############################################################
alias grcd1="../gradlew clean deploy"
alias grcd2="../../gradlew clean deploy"
alias grcd3="../../../gradlew clean deploy"
alias grcd4="../../../../gradlew clean deploy"
alias grcd5="../../../../../gradlew clean deploy"

alias grfs="gradle formatSource"

# Update master private
alias abwd="ant -f build-working-dir.xml"

############################################################
# Project-specific deploying
############################################################

deployCMP() {
	local dir="$PWD";
	local portalDir="";

	while [ "${dir}" != "/" ]; do
		if [ -d "${dir}/modules/apps" ]; then
			portalDir="${dir}";

			break;
		fi;

		dir="$(dirname "${dir}")";
	done;

	if [ -z "${portalDir}" ]; then
		echo "❌ Could not find a parent portal directory (no modules/apps found)";

		return 1;
	fi;

	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ ▶️ Deploying site/site-cmp-site-initializer (renderers)          ║"
	echo "╚═══════════════════════════════════════════════════════════════════╝";

	cd "${portalDir}/modules/apps/site/site-cmp-site-initializer";

	gradle clean deploy -a;

	cd -;

	echo "╔═══════════════════════════════════════════════════════════════════╗";
	echo "║ ▶️ Deploying site-initializer/site-initializer-cmp (templates)   ║"
	echo "╚═══════════════════════════════════════════════════════════════════╝";

	cd "${portalDir}/modules/apps/site-initializer/site-initializer-cmp";

	gradle clean deploy -a;

	cd -;
}

