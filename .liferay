# Find specific processes
alias pj="ps -ef | rg java"
alias pt="ps -ef | rg bundles/tomcat/"

alias ptm='ps -ef | rg master/bundles/tomcat/ | rg java | awk '\''{print $2}'\'''

# Kill processes
alias km="kill -9 $(ptm)"

# Kill and restart servers
alias kmr="kill -9 $(ptm) && lrsm"

alias killp="kill -9"

